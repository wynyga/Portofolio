# Site URL (used for social-share metadata, robots.txt and sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Crew wall (optional) ---------------------------------------------------
# Without these the site works normally: visitors can still draw an astronaut that
# replaces the footer runner in their own browser, but the shared wall is switched off.
#
# Create an Upstash Redis database from the Vercel dashboard (Storage / Marketplace).
# Vercel injects these automatically (KV_REST_API_URL / KV_REST_API_TOKEN also work):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PIN for wiping the wall (click the Earth in the footer) and for /admin/crew.
# Optional: it defaults to a PIN set in app/api/admin/astronauts/route.ts. Set this to use your own,
# which you should do if the repository is public.
ADMIN_KEY=

# PIN that clears one visitor's "too many requests" limit (the Reset PIN field).
# Optional: defaults to a PIN set in app/api/astronauts/reset/route.ts. Set your own if the repo is public.
RESET_PIN=
